{
  "name": "sociosclient",
  "version": "0.1.0",
  "description": "Launcher Minecraft Java original com login Microsoft e instalacao de versoes oficiais.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.17",
    "discord-rpc": "^4.0.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.0.0"
  },
  "overrides": {
    "form-data": "^4.0.5",
    "qs": "^6.15.1",
    "tough-cookie": "^4.1.3",
    "request": "file:./local-request-shim"
  },
  "build": {
    "appId": "com.sociosclient.app",
    "productName": "Socios Client",
    "icon": "logosocios.png",
    "files": [
      "src/**/*",
      "package.json",
      "logosocios.png",
      "taskbar-logo.png",
      "local-request-shim/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "logosocios.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
